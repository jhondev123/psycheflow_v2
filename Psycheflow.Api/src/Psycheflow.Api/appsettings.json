{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "psycheflow-api",
    "Audience": "psycheflow-front",
    "Key": "",
    "ExpirationMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "Path": "storage"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Ai": { "PermitLimit": 20, "WindowSeconds": 60 }
  },
  "Ai": {
    "Claude": { "ApiKey": "", "Model": "claude-opus-5" },
    "OpenAi": { "ApiKey": "", "Model": "gpt-5" },
    "Gemini": { "ApiKey": "", "Model": "gemini-2.5-pro" },
    "MaxOutputTokens": 16000,
    "TimeoutSeconds": 120
  }
}
