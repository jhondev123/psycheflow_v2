# Copie para .env (o .env não é versionado).
POSTGRES_DB=psycheflow
POSTGRES_USER=psycheflow
POSTGRES_PASSWORD=psycheflow-dev
POSTGRES_PORT=5432

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# Mínimo 32 caracteres. Em produção gere uma chave aleatória (ex.: openssl rand -base64 48).
JWT_KEY=dev-only-key-troque-em-producao-0123456789abcdef
FRONT_URL=http://localhost:5173

# Assistente de IA (opcional). Deixe vazio o provedor que não for usar; as chaves nunca vão para o banco.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
